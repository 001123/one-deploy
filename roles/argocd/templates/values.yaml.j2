# Helm Values for ArgoCD (Generated by Ansible)
# Architecture: Non-HA (Single Replica for Lab/Dev)

{% if argocd_ingress_enabled %}
global:
  domain: "{{ argocd_ingress_hostname }}"
{% endif %}

configs:
  cm:
    application.resourceTrackingMethod: "{{ argocd_resource_tracking_method }}"

server:
  replicas: 1
  service:
    type: {{ argocd_server_service_type }}
{% if argocd_server_service_type == 'NodePort' %}
    nodePortHttp: {{ argocd_server_nodeport_http }}
    nodePortHttps: {{ argocd_server_nodeport_https }}
{% endif %}
  ingress:
    enabled: {{ argocd_ingress_enabled | lower }}
{% if argocd_ingress_enabled %}
    ingressClassName: "{{ argocd_ingress_class_name }}"
    hostname: "{{ argocd_ingress_hostname }}"
    paths:
      - /
    pathType: Prefix
    tls: false
{% endif %}

controller:
  replicas: 1

repoServer:
  replicas: 1
{% if argocd_sops_enabled %}
  volumes:
    - name: cmp-plugin-sops
      configMap:
        name: argocd-cmp-sops
    - name: custom-tools
      emptyDir: {}
    - name: sops-age
      secret:
        secretName: {{ argocd_sops_age_secret_name }}
        items:
          - key: keys.txt
            path: key.txt
    - name: cmp-tmp
      emptyDir: {}
  initContainers:
    - name: download-sops
      image: alpine:3.20
      command: ["/bin/sh", "-c"]
      args:
        - |
          ARCH=$(uname -m)
          case $ARCH in
            x86_64) S_ARCH="amd64" ;;
            aarch64|arm64) S_ARCH="arm64" ;;
            *) S_ARCH="amd64" ;;
          esac
          wget -qO /custom-tools/sops "https://github.com/getsops/sops/releases/download/v{{ argocd_sops_version }}/sops-v{{ argocd_sops_version }}.linux.${S_ARCH}"
          chmod +x /custom-tools/sops
      volumeMounts:
        - mountPath: /custom-tools
          name: custom-tools
  extraContainers:
    - name: sops-cmp
      command: ["/var/run/argocd/argocd-cmp-server"]
      # Helm renders this expression so the CMP always matches the repo-server image.
{% raw %}
      image: '{{ default .Values.global.image.repository .Values.repoServer.image.repository }}:{{ default (include "argo-cd.defaultTag" .) .Values.repoServer.image.tag }}'
{% endraw %}
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
      env:
        - name: PATH
          value: "/custom-tools:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        - name: SOPS_AGE_KEY_FILE
          value: /home/argocd/cmp-server/config/age/key.txt
      volumeMounts:
        - mountPath: /var/run/argocd
          name: var-files
        - mountPath: /home/argocd/cmp-server/plugins
          name: plugins
        - mountPath: /tmp
          name: cmp-tmp
        - mountPath: /custom-tools
          name: custom-tools
        - mountPath: /home/argocd/cmp-server/config/plugin.yaml
          subPath: plugin.yaml
          name: cmp-plugin-sops
        - mountPath: /home/argocd/cmp-server/config/age/key.txt
          subPath: key.txt
          name: sops-age
{% endif %}

applicationSet:
  enabled: true
  replicaCount: 1

redis:
  enabled: true

redis-ha:
  enabled: false
